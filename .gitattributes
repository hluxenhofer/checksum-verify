# Auto-detect text files and normalize line endings to CRLF on Windows
* text=auto eol=crlf

# Shell-processed files must use LF so sed/awk on Linux CI work correctly
CHANGELOG.md text eol=lf

# Force binary files to not be modified
*.png binary
*.ico binary
*.exe binary
*.dll binary
*.msi binary

# Workflows, scripts and anything run on Linux CI must use LF
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.github/** text eol=lf

# Images
*.gif binary
