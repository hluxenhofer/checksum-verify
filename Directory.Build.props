<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <Authors>Heiko Luxenhofer</Authors>
    <Product>ChecksumVerify</Product>
    <Version>0.2.0</Version>
    <RepositoryUrl>https://github.com/hluxenhofer/checksum-verify</RepositoryUrl>
    <PackageProjectUrl>https://github.com/hluxenhofer/checksum-verify</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © 2026 Heiko Luxenhofer</Copyright>
  </PropertyGroup>
</Project>
