<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChecksumVerify.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Verify Checksum">

    <Grid Padding="24,16,24,24" RowSpacing="16" MinWidth="480" MaxWidth="640">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ResultSuccessBackgroundBrush" Color="#DFF6DD"/>
                        <SolidColorBrush x:Key="ResultSuccessForegroundBrush" Color="#107C10"/>
                        <SolidColorBrush x:Key="ResultErrorBackgroundBrush"   Color="#FDE7E9"/>
                        <SolidColorBrush x:Key="ResultErrorForegroundBrush"   Color="#C50F1F"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="ResultSuccessBackgroundBrush" Color="#393D1B"/>
                        <SolidColorBrush x:Key="ResultSuccessForegroundBrush" Color="#6CCB5F"/>
                        <SolidColorBrush x:Key="ResultErrorBackgroundBrush"   Color="#442726"/>
                        <SolidColorBrush x:Key="ResultErrorForegroundBrush"   Color="#FF8585"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="ResultSuccessBackgroundBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="ResultSuccessForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                        <SolidColorBrush x:Key="ResultErrorBackgroundBrush"   Color="Transparent"/>
                        <SolidColorBrush x:Key="ResultErrorForegroundBrush"   Color="{ThemeResource SystemColorWindowTextColor}"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- File header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="FILE"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.6"
                       CharacterSpacing="50"/>
            <TextBlock x:Name="FileNameText"
                       TextWrapping="Wrap"
                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
        </StackPanel>

        <!-- Algorithm -->
        <ComboBox Grid.Row="1"
                  x:Name="AlgorithmCombo"
                  Header="Algorithm"
                  HorizontalAlignment="Stretch"
                  SelectionChanged="OnAlgorithmChanged"/>

        <!-- Hash source + input -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton x:Name="HashModeRadio" Content="Enter hash" Checked="OnModeChanged"/>
                <RadioButton x:Name="FileModeRadio" Content="Hash file"  Checked="OnModeChanged"/>
            </StackPanel>

            <Grid x:Name="HashPanel" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HashInput"
                         Grid.Column="0"
                         Header="Expected hash"
                         PlaceholderText="Paste or type a hash"
                         FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                         TextChanged="OnHashInputChanged"/>
                <Button Grid.Column="1"
                        Content="Paste"
                        VerticalAlignment="Bottom"
                        Click="OnPaste"/>
            </Grid>

            <Grid x:Name="FilePanel" ColumnSpacing="8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HashFileInput"
                         Grid.Column="0"
                         Header="Hash file"
                         IsReadOnly="True"
                         PlaceholderText="Select a hash file…"/>
                <Button Grid.Column="1"
                        Content="Browse…"
                        VerticalAlignment="Bottom"
                        Click="OnBrowse"/>
            </Grid>
        </StackPanel>

        <!-- Progress (collapsed until computing) -->
        <ProgressBar Grid.Row="3"
                     x:Name="ComputeProgress"
                     Minimum="0"
                     Visibility="Collapsed"
                     IsIndeterminate="False"/>

        <!-- Result banner (collapsed until verified) -->
        <Border Grid.Row="4"
                x:Name="ResultBorder"
                Visibility="Collapsed"
                CornerRadius="4"
                Padding="14,12">
            <StackPanel Spacing="8">
                <TextBlock x:Name="ResultText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextWrapping="Wrap"/>
                <StackPanel x:Name="HashSection" Visibility="Collapsed" Spacing="4">
                    <TextBlock Text="Computed hash — copied to clipboard"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7"/>
                    <TextBox x:Name="ComputedHashDisplay"
                             IsReadOnly="True"
                             FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="CopyHashButton"
                    Content="Copy hash"
                    Visibility="Collapsed"
                    Click="OnCopyHash"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel"/>
            <Button x:Name="VerifyButton"
                    Content="Verify"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnVerify"/>
        </StackPanel>
    </Grid>
</Window>
